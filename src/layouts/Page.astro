---
import Prose from '@deramond.dev/astro/components/Prose.astro';
import Section from '@deramond.dev/astro/components/Section.astro';
import SiteLayout from '@deramond.dev/astro/layouts/SiteLayout.astro';

// Layout of the Markdown pages outside the guide (about the author, cookie policy).
const { frontmatter } = Astro.props;
---

<SiteLayout title={frontmatter.title} description={frontmatter.description}>
	<Section>
		<h1>{frontmatter.title}</h1>
		<Prose>
			<slot />
		</Prose>
	</Section>
</SiteLayout>
