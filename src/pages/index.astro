---
export const prerender = true;

import { getCollection } from 'astro:content';
import Button from '@deramond.dev/astro/components/Button.astro';
import Hero from '@deramond.dev/astro/components/Hero.astro';
import PostCard from '@deramond.dev/astro/components/PostCard.astro';
import ProjectCard from '@deramond.dev/astro/components/ProjectCard.astro';
import ProjectGrid from '@deramond.dev/astro/components/ProjectGrid.astro';
import Section from '@deramond.dev/astro/components/Section.astro';
import SectionHeader from '@deramond.dev/astro/components/SectionHeader.astro';
import SiteLayout from '@deramond.dev/astro/layouts/SiteLayout.astro';
import { isoDate, postHref, readingTime, sortPosts } from '@deramond.dev/astro/blog';
import ShowcaseBanner from '../components/ShowcaseBanner.astro';
import { modules as guideModules } from '../guide-modules.mjs';
import hero from '../brand/hero.svg';

// One icon per guide module, keyed by the module's folder.
const icons = import.meta.glob<string>('../brand/modules/*.svg', { query: '?raw', import: 'default', eager: true });
const iconOf = (id: string) => icons[`../brand/modules/${id.slice('guide/'.length)}.svg`];

// The guide's modules, in sidebar order: the module list is the one source, so a new module lands here on its own and
// other pages at the guide's root (like /guide/checklists/) don't.
const docs = new Map((await getCollection('docs')).map((entry) => [entry.id, entry]));
const modules = guideModules.map(({ dir }) => docs.get(`guide/${dir}`)!);

const articles = sortPosts(await getCollection('articles'), { production: import.meta.env.PROD }).slice(0, 3);
---

<SiteLayout
	title="Open {re}Source"
	description="Open source, {re}explained. How it works, how to contribute, how to run your own project: a free guide, articles and a showcase."
>
	<Hero
		lead="How it works, how to contribute, how to run your own project. A free guide, articles and a showcase by the Open {re}Source community."
		image={hero}
	>
		<Fragment slot="title">
			Open source, <em class="d-cy">{'{re}'}</em>explained.
		</Fragment>
		<Fragment slot="actions">
			<Button variant="gold" href="/guide/start/">
				Follow the guide
			</Button>
			<Button href="/articles/">Read the articles</Button>
			<Button variant="quiet" href="https://github.com/Open-reSource/openresource.dev">
				GitHub
			</Button>
		</Fragment>
	</Hero>

	<Section>
		<SectionHeader num="01" label="Guide" title="Ten modules, from the first contribution to funding" />
		<ProjectGrid>
			{modules.map((entry, i) => (
				<ProjectCard
					num={String(i + 1).padStart(2, '0')}
					name={entry.data.title}
					description={entry.data.description ?? ''}
					href={`/${entry.id}/`}
				>
					<Fragment slot="icon" set:html={iconOf(entry.id)} />
				</ProjectCard>
			))}
		</ProjectGrid>
	</Section>

	<Section>
		<SectionHeader num="02" label="Articles" title="Latest articles" />
		<div class="posts">
			{articles.map((post) => (
				<PostCard
					href={postHref('/', 'articles', post.id)}
					title={post.data.title}
					description={post.data.description}
					date={isoDate(post.data.date)}
					minutes={readingTime(post.body)}
					tags={post.data.tags}
				/>
			))}
		</div>
		<div class="more">
			<Button variant="quiet" href="/articles/">
				All articles
			</Button>
		</div>
	</Section>

	<Section>
		<SectionHeader num="03" label="Showcase" title="What the community builds" />
		<ShowcaseBanner showProjectsButton />
	</Section>

	<Section>
		<SectionHeader
			num="04"
			label="Support us"
			title="Keep Open {re}Source going"
			lead="Help us continue to build and maintain this project by becoming a sponsor or dropping a star on our GitHub repository."
		/>
		<div class="actions">
			<Button href="https://github.com/sponsors/Open-reSource">Become a sponsor</Button>
			<Button variant="quiet" href="https://github.com/Open-reSource/openresource.dev">
				Star on GitHub
			</Button>
		</div>
	</Section>
</SiteLayout>

<style>
	.posts {
		display: grid;
		gap: var(--space-5);
	}

	@media (min-width: 980px) {
		.posts {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.more,
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-7);
	}
</style>
