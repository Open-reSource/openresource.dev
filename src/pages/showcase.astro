---
export const prerender = true;

import Section from '@deramond.dev/astro/components/Section.astro';
import SectionHeader from '@deramond.dev/astro/components/SectionHeader.astro';
import SiteLayout from '@deramond.dev/astro/layouts/SiteLayout.astro';
import Showcase from '../components/Showcase.astro';

const description = 'Explore what the Open {re}Source community builds for the open source world.';
---

<SiteLayout title="Showcase" description={description}>
	<Section>
		<SectionHeader as="h1" num="04" label="Showcase" title="Showcase" lead={description} />
		<Showcase />
	</Section>
</SiteLayout>
