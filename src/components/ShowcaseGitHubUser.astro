---
import ShowcaseEntry from './ShowcaseEntry.astro';

export interface Props {
	description: string;
	img: string;
	name: string;
}

const { description, img, name } = Astro.props;
---

<ShowcaseEntry
	name={name}
	picture={`https://avatars.githubusercontent.com/u/${img}?s=96`}
	href={`https://github.com/${name}`}
	description={description}
/>
