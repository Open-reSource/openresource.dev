---
// The facts about one project, in a card at the top of its section: since when, under which license, who decides, and
// one number with its date. Hand-entered: every value comes from a source the text links, and the number says when.
interface Props {
	name: string;
	href: string;
	since: string;
	license: string;
	decides: string;
	number: string;
}

const { name, href, since, license, decides, number } = Astro.props;
---

<aside class="project-stats plate" aria-label={`${name} in numbers`}>
	<p class="project-stats__name">
		<a href={href}>{name}</a>
	</p>
	<dl class="project-stats__facts">
		<div>
			<dt>Since</dt>
			<dd>{since}</dd>
		</div>
		<div>
			<dt>License</dt>
			<dd>{license}</dd>
		</div>
		<div>
			<dt>Who decides</dt>
			<dd>{decides}</dd>
		</div>
		<div class="project-stats__number">
			<dt>In numbers</dt>
			<dd>{number}</dd>
		</div>
	</dl>
</aside>

<style>
	/* A plate pressed into the page: the project's name in ink, then its facts as labelled columns. */
	.project-stats {
		margin: var(--space-5) 0;
		padding: 18px 22px 20px;
	}

	.project-stats__name {
		margin: 0 0 var(--space-3);
		font: var(--paper-type-label);
		font-weight: var(--paper-font-weight-bold);
		letter-spacing: var(--paper-type-label-letter-spacing);
		text-transform: uppercase;
	}

	.project-stats__facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		gap: var(--space-3) var(--space-5);
		margin: 0;
	}

	.project-stats__facts dt {
		font: var(--paper-type-label);
		letter-spacing: var(--paper-type-label-letter-spacing);
		text-transform: uppercase;
		color: var(--paper-color-muted);
	}

	.project-stats__facts dd {
		margin: 2px 0 0;
		font: var(--paper-type-table);
		color: var(--paper-color-ink);
	}

	.project-stats__number {
		grid-column: 1 / -1;
	}
</style>
