---
import ShowcaseEntry from './ShowcaseEntry.astro';

export interface Props {
	description: string;
	env: string;
	img: string;
	repo: string;
}

const { description, env, img, repo } = Astro.props;

const picture = img.includes('https://') ? img : `https://avatars.githubusercontent.com/u/${img}?s=96`;
---

<ShowcaseEntry
	name={`<span class="owner">${env}/</span><br/>${repo}`}
	picture={picture}
	href={`https://github.com/${env}/${repo}`}
	description={description}
/>

<style>
	:global(.owner) {
		font-weight: var(--font-weight-regular);
		color: var(--color-muted);
	}
</style>
