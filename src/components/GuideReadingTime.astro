---
import { getCollection } from 'astro:content';
import { readingTime } from '@deramond.dev/astro/blog';
import { formatMinutes } from '../reading-time.mjs';

// Reading time of the guide, or of one module: every page under the current path, or under `of` (`guide`,
// `guide/licensing`). `inline` prints the duration alone, for a sentence that quotes it.
interface Props {
	of?: string;
	inline?: boolean;
}

const { of, inline = false } = Astro.props;
const slug = of ?? Astro.url.pathname.replace(/^\/|\/$/g, '');

const docs = await getCollection('docs');
const guideReadingTime = docs
	.filter((doc) => doc.id !== slug && doc.id.startsWith(`${slug}/`))
	.reduce((total, doc) => total + readingTime(doc.body), 0);
const duration = formatMinutes(guideReadingTime);
---

{inline ? (
	duration
) : (
	<p class="reading-time">
		This {slug === 'guide' ? 'guide' : 'module'} will take you approximately <b>{duration}</b> to read.
	</p>
)}

<style>
	.reading-time {
		font: var(--type-mono);
		color: var(--color-muted);
	}

	b {
		color: var(--color-fg);
		font-weight: var(--font-weight-medium);
	}
</style>
