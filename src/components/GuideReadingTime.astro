---
import { getCollection } from 'astro:content';
import { readingTime } from '@deramond.dev/astro/blog';

// Reading time of the guide, or of one module: every page under the current path.
const slug = Astro.url.pathname.replace(/^\/|\/$/g, '');

const docs = await getCollection('docs');
const guideReadingTime = docs
	.filter((doc) => doc.id !== slug && doc.id.startsWith(`${slug}/`))
	.reduce((total, doc) => total + readingTime(doc.body), 0);
const duration =
	guideReadingTime >= 60
		? `${Math.floor(guideReadingTime / 60)} h ${Math.ceil(guideReadingTime % 60)} min`
		: `${guideReadingTime} min`;
---

<p class="reading-time">
	This {slug === 'guide' ? 'guide' : 'module'} will take you approximately <b>{duration}</b> to read.
</p>

<style>
	.reading-time {
		font: var(--type-mono);
		color: var(--color-muted);
	}

	b {
		color: var(--color-fg);
		font-weight: var(--font-weight-medium);
	}
</style>
