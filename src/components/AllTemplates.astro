---
// The templates gallery: one <Template> per entry of src/templates.mjs, with the title of the chapter that uses it.
import { getCollection } from 'astro:content';
import { templateId, templates } from '../templates.mjs';
import Template from './Template.astro';

const docs = new Map((await getCollection('docs')).map((doc) => [doc.id, doc]));
---

<ul>
	{templates.map(({ file, description }) => (
		<li>
			<a href={`#${templateId(file)}`}>
				<code>{file}</code>
			</a>
			: {description}
		</li>
	))}
</ul>

{templates.map(({ file, chapter }) => (
	<Template name={file} chapter={{ href: `/${chapter}/`, title: docs.get(chapter)!.data.title }} />
))}
