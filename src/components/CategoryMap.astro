---
// A map of categories in groups: each group a labeled frame, each category a box that links to its section, with a
// few examples under its name. HTML, not an SVG: the grid reflows to one column on a phone and the text stays legible.
type Category = { label: string; href: string; examples: string };
type Group = { label: string; categories: Category[] };

interface Props {
	label: string;
	groups: Group[];
}

const { label, groups } = Astro.props;
---

<figure class="category-map" aria-label={label}>
	{groups.map((group, index) => (
		<div class="category-map__group plate">
			<p class="category-map__title" id={`category-map-${index}`}>
				{group.label}
			</p>
			<ul class="category-map__list" aria-labelledby={`category-map-${index}`}>
				{group.categories.map(({ label, href, examples }) => (
					<li class="category-map__item">
						<a href={href}>{label}</a>
						<span class="category-map__examples">{examples}</span>
					</li>
				))}
			</ul>
		</div>
	))}
</figure>

<style>
	/* Each group a plate pressed into the page, its label in ink; each category a box framed in the hairline's
	   stronger sibling, with its examples in muted. */
	.category-map {
		display: grid;
		gap: var(--space-4);
		margin: var(--space-5) 0;
	}

	.category-map__group {
		padding: 18px 20px 20px;
	}

	.category-map__title {
		margin: 0 0 var(--space-3);
		font: var(--paper-type-label);
		font-weight: var(--paper-font-weight-bold);
		letter-spacing: var(--paper-type-label-letter-spacing);
		text-transform: uppercase;
		color: var(--paper-color-ink);
	}

	.category-map__list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.category-map__item {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		margin: 0;
		padding: var(--space-2) var(--space-3);
		border: 1px solid var(--paper-color-line-strong);
	}

	.category-map__item a {
		font-weight: var(--paper-font-weight-bold);
	}

	.category-map__examples {
		font: var(--paper-type-small);
		color: var(--paper-color-muted);
	}

	@media (max-width: 30rem) {
		.category-map__list {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
