---
// A screenshot in the text: the package's screenshot figure, printed in ink on a plate with 14 px of paper round it.
// The picture is a button that opens the original, in its own colours, in a dialog nearly the whole window.
// The print needs the theme the capture was taken in: for a file in public/, it is read here from the picture's mean
// brightness (most of the guide's captures are GitHub in its dark theme, the articles' mostly light). A remote picture
// (a badge, a sponsors image) keeps its colours.
import path from 'node:path';
import sharp from 'sharp';
import Figure from '@deramond.dev/astro/components/Figure.astro';

interface Props {
	src: string;
	alt: string;
	width?: number;
	height?: number;
}

const { src, alt, width, height } = Astro.props;
const local = src.startsWith('/');
let source: 'light' | 'dark' = 'light';
if (local) {
	const { channels } = await sharp(path.join(process.cwd(), 'public', src)).stats();
	const mean = channels.slice(0, 3).reduce((sum, channel) => sum + channel.mean, 0) / 3;
	source = mean < 128 ? 'dark' : 'light';
}
---

<Figure
	src={src}
	alt={alt}
	width={width}
	height={height}
	screenshot
	source={source}
	print={local}
	class="content-image"
/>
