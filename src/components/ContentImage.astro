---
import { Image } from 'astro:assets';

const { src, alt, width, height } = Astro.props;
const fullSize = typeof src === 'string' ? src : src.src;
---

<div>
	<a href={fullSize}>
		<Image src={src} alt={alt} width={width} height={height} />
		<span class="d-visually-hidden">(full size)</span>
	</a>
</div>

<style>
	div {
		width: 100%;
		height: auto;
		display: flex;
		justify-content: center;
	}

	a {
		display: block;
		cursor: zoom-in;
	}

	img {
		border: var(--stroke-hairline) solid var(--color-line);
	}
</style>
