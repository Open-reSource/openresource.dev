---
export interface Props {
	author: string;
	type: string; // 'start' | 'end'
	thinking?: boolean;
}

const { author, thinking, type } = Astro.props;
---

<div class:list={['chat', 'chat-' + type, { 'chat-thinking': thinking }]}>
	<div class="chat-header">
		{author}
		<span class="d-visually-hidden">{thinking ? 'thinks' : 'says'}</span>
	</div>
	<div class="chat-bubble">
		<slot />
	</div>
</div>

<style>
	/* Two sides of a conversation: the author's name above each bubble, the side and the border tell them apart. */
	.chat {
		display: grid;
		column-gap: var(--space-3);
		padding-block: var(--space-1);
	}

	.chat-start {
		justify-items: start;
	}

	.chat-end {
		justify-items: end;
	}

	.chat-header {
		font: var(--type-mono-label);
		letter-spacing: var(--font-letter-spacing-mono-label);
		color: var(--color-muted);
		text-transform: uppercase;
	}

	.chat-bubble {
		width: fit-content;
		max-width: 90%;
		margin-top: var(--space-1);
		padding: var(--space-3) var(--space-4);
		border: var(--stroke-ui) solid var(--color-line);
		border-radius: var(--radius-md);
		background: var(--color-panel);
		color: var(--color-fg);
	}

	.chat-start .chat-bubble {
		border-color: var(--color-primary-dim);
		border-end-start-radius: var(--radius-none);
	}

	.chat-end .chat-bubble {
		border-end-end-radius: var(--radius-none);
	}

	.chat-thinking .chat-bubble {
		border-style: dashed;
		background: transparent;
		color: var(--color-muted);
	}
</style>
