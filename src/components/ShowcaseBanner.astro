---
import { Button } from '@deramond.dev/astro';

const { showProjectsButton = false } = Astro.props;
---

<section class="showcase-banner d-cut">
	<h2>Showcase your projects</h2>
	<p>
		<strong>Explore what the Open &#123;re&#125;Source community builds for the open source world.</strong>
	</p>
	<p>
		Submit your open-source project(s), profiles or websites to the showcase and let the community discover your work.
	</p>
	<div class="actions">
		<Button href="https://github.com/orgs/Open-reSource/discussions/3">Submit your project(s)</Button>
		{showProjectsButton && (
			<Button variant="quiet" href="/showcase/">
				Show projects
			</Button>
		)}
	</div>
</section>

<style>
	.showcase-banner {
		padding: var(--space-7);
		border: var(--stroke-hairline) solid var(--color-line);
		border-left: var(--stroke-bracket) solid var(--color-primary);
		background: var(--color-panel);
	}

	h2 {
		margin: 0 0 var(--space-4);
		font: var(--type-heading);
	}

	p {
		margin: 0 0 var(--space-3);
		color: var(--color-muted);
	}

	strong {
		color: var(--color-fg);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-5);
	}
</style>
