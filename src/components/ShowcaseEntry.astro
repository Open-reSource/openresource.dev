---
// One showcase entry: avatar, name and description, the whole card a link.
export interface Props {
	href: string;
	/** HTML: a repository shows `owner/` above its name. */
	name: string;
	picture?: string;
	description: string;
}

const { href, name, picture, description } = Astro.props;
---

<a class="entry island not-content" href={href}>
	{picture && <img src={picture} alt="" width="48" height="48" loading="lazy" />}
	<span class="text">
		<span class="name" set:html={name} />
		<span class="description" set:html={description} />
	</span>
</a>

<style>
	.entry {
		display: flex;
		gap: var(--space-4);
		align-items: flex-start;
		min-width: 0;
		padding: var(--space-4);
		color: var(--paper-color-reading);
		text-decoration: none;
	}

	/* Paper left standing in the showcase's tray: the card never lifts, its name answers the hover. */
	.entry:hover .name {
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.18em;
	}

	.entry:focus-visible {
		outline: var(--paper-stroke-focus) solid var(--paper-color-ink);
		outline-offset: var(--paper-stroke-focus-offset-raised);
	}

	img {
		flex: none;
		border-radius: 0;
	}

	.text {
		display: grid;
		gap: var(--space-1);
		min-width: 0;
	}

	.name {
		font: var(--paper-type-tile);
		font-size: 19px;
		letter-spacing: var(--paper-type-tile-letter-spacing);
		text-transform: uppercase;
		color: var(--paper-color-ink);
		overflow-wrap: anywhere;
	}

	.description {
		font: var(--paper-type-table);
		color: var(--paper-color-muted);
		overflow-wrap: anywhere;
	}
</style>
